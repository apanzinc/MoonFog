{
  "manifest_version": 3,
  "default_locale": "zh_CN",
  "name": "__MSG_extName__",
  "version": "1.1.1",
  "description": "__MSG_extDesc__",
  "author": "apanzinc",
  "browser_specific_settings": {
    "gecko": {
      "id": "moonfog@apanzinc.top",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "js/extension-background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon-light-16.png",
      "32": "icons/icon-light-32.png",
      "48": "icons/icon-light-48.png",
      "128": "icons/icon-light-128.png"
    },
    "theme_icons": [
      {
        "dark": "icons/icon-dark-16.png",
        "light": "icons/icon-light-16.png",
        "size": 16
      },
      {
        "dark": "icons/icon-dark-32.png",
        "light": "icons/icon-light-32.png",
        "size": 32
      },
      {
        "dark": "icons/icon-dark-48.png",
        "light": "icons/icon-light-48.png",
        "size": 48
      },
      {
        "dark": "icons/icon-dark-128.png",
        "light": "icons/icon-light-128.png",
        "size": 128
      }
    ]
  },
  "permissions": [
    "fontSettings",
    "search"
  ],
  "host_permissions": [
    "https://www.bing.com/*",
    "https://cn.bing.com/*",
    "https://hitokoto.c0ffee.space/*",
    "https://v1.hitokoto.cn/*",
    "https://icons.duckduckgo.com/*"
  ],
  "optional_host_permissions": [
    "https://api.bing.com/*",
    "https://suggestqueries.google.com/*",
    "https://suggestion.baidu.com/*"
  ]
}
