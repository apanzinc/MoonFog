{
  "manifest_version": 3,
  "default_locale": "zh_CN",
  "name": "__MSG_extName__",
  "version": "1.1.0.2",
  "description": "__MSG_extDesc__",
  "author": "apanzinc",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-light-16.png",
      "32": "icons/icon-light-32.png",
      "48": "icons/icon-light-48.png",
      "128": "icons/icon-light-128.png"
    },
    "theme_icons": [
      {
        "dark": "icons/icon-dark-16.png",
        "light": "icons/icon-light-16.png",
        "size": 16
      },
      {
        "dark": "icons/icon-dark-32.png",
        "light": "icons/icon-light-32.png",
        "size": 32
      },
      {
        "dark": "icons/icon-dark-48.png",
        "light": "icons/icon-light-48.png",
        "size": 48
      },
      {
        "dark": "icons/icon-dark-128.png",
        "light": "icons/icon-light-128.png",
        "size": 128
      }
    ]
  },
  "permissions": [
    "fontSettings"
  ],
  "host_permissions": [
    "https://www.bing.com/*",
    "https://cn.bing.com/*",
    "https://hitokoto.c0ffee.space/*",
    "https://v1.hitokoto.cn/*",
    "https://www.google.com/*",
    "https://icons.duckduckgo.com/*",
    "https://search-sug.lonely.land/*"
  ]
}
